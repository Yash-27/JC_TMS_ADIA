# Julia
Manifest.toml
*.jli
*.ji

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
*.swp

# Deny-by-default: ignore everything, then re-include by exception.
# Results (.jld2), figures (.pdf) and notebooks (.nb) are deliberately out.
# A new non-.jl file that SHOULD be tracked needs its own "!" line here --
# without one it is invisible to git, with no warning that it is missing.
*
!.gitignore
!*.jl
!CLAUDE.md
!Project.toml

# file_concurrence/ -- the closed-form adiabatic-concurrence note. The directory
# must be re-included FIRST: git does not descend into an ignored directory, so a
# bare "!file_concurrence/concurrence_adia.md" on its own is inert. This is the one
# exception that reaches into a subdirectory; !*.jl above still does not.
# files_online/ is deliberately NOT given this treatment -- it stays local-only.
!file_concurrence/
!file_concurrence/*.md
